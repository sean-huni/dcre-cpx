<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- SCRUM-58 (spec 1.4): a 129+ char reply name registers in agt_ops
         (file_arrival.physical_filename is 512) then crashes the reader
         insert mid-flow. Metadata-only widening in CRDB. -->
    <changeSet id="004-pbsr-resp-width-pxr" author="dcre">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="pbsr_resp" columnName="response_file"/>
        </preConditions>
        <comment>128 to 512: match file_arrival.physical_filename; re-widening to the same type is a no-op.</comment>
        <modifyDataType tableName="pbsr_resp" columnName="response_file" newDataType="VARCHAR(512)"/>
        <!-- Liquibase appends " USING (response_file::VARCHAR(512))" on the postgres
             family; CRDB classifies the USING form as an on-disk rewrite and refuses
             it on indexed columns (issue 47636; response_file is in the replay-guard
             UNIQUE). The bare SET DATA TYPE widen is metadata-only and succeeds
             (verified live against cockroach v26.2.3), so strip the cast.
             dbms must include cockroachdb: Liquibase detects CRDB as its own type. -->
        <modifySql dbms="postgresql, cockroachdb">
            <replace replace=" USING (response_file::VARCHAR(512))" with=""/>
        </modifySql>
    </changeSet>

</databaseChangeLog>
